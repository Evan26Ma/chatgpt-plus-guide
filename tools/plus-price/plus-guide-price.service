[Unit]
Description=Refresh Philippines ChatGPT Plus daily reference price
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -B /opt/plus-guide-price/update_price.py
TimeoutStartSec=120
UMask=0022
StateDirectory=plus-guide-price
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/plus-guide-price /var/www/map.plus-guide.fun /var/www/plus-guide
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_DAC_OVERRIDE
LockPersonality=true
